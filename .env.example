# Copy to .env.local. Keep tokens private.
APP_URL=http://localhost:8200
# Generate a strong random secret (at least 32 characters). Never commit it.
BETTER_AUTH_SECRET=
# Optional: reserve pre-authentication projects for this signup email.
LEGACY_OWNER_EMAIL=
# Set your Neon/Postgres connection URL in .env. Keep the URL's TLS parameters.
# DATABASE_URL=postgresql://...
META_API_VERSION=v25.0
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Optional when the endpoint has exactly one bucket.
AWS_S3_BUCKET=uploads
# Channel credentials are configured per project in the dashboard.
# MCP OAuth connections and bearer tokens belong to the user account.
# Credentials are stored in Postgres.

# Meta request/response logs (including in production); use info to suppress debug.
LOG_LEVEL=debug

# Server-owned Meta app credentials for customer OAuth connections.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Use the Instagram App ID/Secret from Instagram Login setup (not the Facebook App ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn customer OAuth: enable Share on LinkedIn and Sign In with OpenID Connect.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202605
# Enable only after Community Management API access is approved for company Pages.
LINKEDIN_ORGANIZATION_POSTING=false

# Public company disclosure (address and tax ID have supplied defaults).
# COMPANY_REGISTERED_ADDRESS=
# COMPANY_TAX_ID=
# Optional override for the supplied Commercial Registry name.
# COMPANY_REGISTRY_DETAILS=Registro Mercantil de Barcelona
