# Copy to .env.local. Keep tokens private.
APP_URL=http://localhost:8200
# Required for remote dashboard access. Username: admin
APP_PASSWORD=
# Required to enable the MCP endpoint. Generate a long random token.
MCP_TOKEN=
# Set your Neon/Postgres connection URL in .env. Keep the URL's TLS parameters.
# DATABASE_URL=postgresql://...
META_API_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Facebook Login tokens use graph.facebook.com; Instagram Login tokens use graph.instagram.com.
INSTAGRAM_API_HOST=graph.facebook.com
