      "checkConstraints": {
        "posts_title_not_empty": {
          "name": "posts_title_not_empty",
          "value": "length(trim(\"posts\".\"title\")) > 0"
        },
        "posts_caption_length": {
          "name": "posts_caption_length",
          "value": "length(trim(\"posts\".\"caption\")) BETWEEN 1 AND 2200"
        },
        "posts_source_not_empty": {
          "name": "posts_source_not_empty",
          "value": "length(trim(\"posts\".\"source\")) > 0"
        },
        "posts_platforms_valid": {
          "name": "posts_platforms_valid",
          "value": "cardinality(\"posts\".\"platforms\") BETWEEN 1 AND 2 AND array_position(\"posts\".\"platforms\", NULL) IS NULL AND (cardinality(\"posts\".\"platforms\") = 1 OR \"posts\".\"platforms\"[1] <> \"posts\".\"platforms\"[2])"
        },
        "posts_instagram_image_required": {
          "name": "posts_instagram_image_required",
          "value": "NOT ('instagram'::post_platform = ANY(\"posts\".\"platforms\")) OR \"posts\".\"image_key\" IS NOT NULL OR \"posts\".\"image_url\" LIKE 'https://%'"
        },
        "posts_results_object": {
          "name": "posts_results_object",
          "value": "jsonb_typeof(\"posts\".\"results\") = 'object'"
        },
        "posts_image_storage_pair": {
          "name": "posts_image_storage_pair",
          "value": "(\"posts\".\"image_key\" IS NULL) = (\"posts\".\"image_bucket\" IS NULL)"
        }
